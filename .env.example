# Local run
OLLAMA_BASE_URL=http://127.0.0.1:11434
TEV_MODEL=tev1:0.8b

# Docker Compose app -> Ollama
OLLAMA_BASE_URL_DOCKER=http://ollama:11434
# Host Ollama alternative (Docker Desktop, or Linux with host-gateway):
# OLLAMA_BASE_URL_DOCKER=http://host.docker.internal:11434

# Docker Compose host interface for the published Ollama port
OLLAMA_PUBLISH_HOST=127.0.0.1

# Relative paths resolve under the app root (/app in the container)
DB_PATH=./data/feedfilter.db
LOG_PATH=./data/feedfilter.log
LOG_LEVEL=INFO

HOST=127.0.0.1
PORT=8000

# Environment defaults; the Settings page can override these values
MAX_NEW_ITEMS=50
MAX_ITEMS_PER_FEED=10
WINDOW_HOURS=72
# Minimum item/job retention; item retention grows automatically with WINDOW_HOURS
RETENTION_DAYS=30
# Additional overlap when fetching since the last successful refresh
REFRESH_OVERLAP_HOURS=6
RESCORE_DAYS=14
THRESHOLD=0.55
